# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# === Package Managers & Dependencies ===
# This blocks node_modules in the root and inside all 3 apps automatically
node_modules/
.pnpm-debug.log*

# === Build Outputs ===
# Blocks the arm64 binaries and compiled code inside your apps
dist/
build/
out/
.next/
.nuxt/
*.dmg
*.exe
*.pkg

# === Local Environment Files ===
# Keeps your private API keys and tokens off GitHub
.env
.env.local
.env.*.local

# === Operating System Files ===
# Blocks macOS background system files
.DS_Store
Thumbs.db

# === IntelliJ / IDE Configurations ===
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln